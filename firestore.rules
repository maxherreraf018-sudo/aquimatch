rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Único usuario con acceso al panel de moderación: maxherreraf018@gmail.com
    // (entra con Google, correo verificado). Si más adelante el equipo crece,
    // esto se reemplaza por un sistema de roles real.
    //
    // El uid anterior (CLdj1h5eVoS1RknR4flaEoMYZZf1) correspondía a
    // "max_15619@hotmail.com": una cuenta creada por error de tipeo el
    // 2026-07-26 y usada una sola vez. Nunca verificó el correo, así que si esa
    // dirección pertenecía a otra persona, esa persona podía reclamarla con
    // "olvidé mi contraseña" y quedarse con el acceso de administrador.
    // Por eso SIEMPRE hay que dejar anotado a qué correo corresponde el uid.
    function esAdmin() {
      return request.auth != null && request.auth.uid == 'SM1r3pWsTYU2soVHMUmOT1xzIfi2';
    }
    // ID de una conexión (match) entre dos uid, mismo criterio que usa
    // crearConexion() en el cliente: ambos uid ordenados y unidos con "_".
    function idConexion(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    // Bloquear y suspender existían solo en la pantalla: la app filtraba a
    // quien bloqueaste en Descubrir, pero Firestore no le impedía nada. Con un
    // cliente modificado, alguien a quien bloqueaste podía seguir
    // mandándote mensajes — y en una app donde esa persona sabe en qué bar
    // estás, eso no es un detalle técnico.
    //
    // `bloqueados` vive en el documento de quien bloquea (ver bloquearUsuario
    // en src/services/chat.js), así que "¿me bloqueó?" se pregunta mirando SU
    // ficha. `.get(campo, valor)` evita que la regla falle cuando el campo
    // todavía no existe, que es el caso de casi todos.
    function perfilDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data;
    }
    function estaSuspendido(uid) {
      return perfilDe(uid).get('suspendido', false) == true;
    }
    function meBloqueo(otroUid) {
      return request.auth.uid in perfilDe(otroUid).get('bloqueados', []);
    }
    function otroDeLaConexion(conexionId) {
      let usuarios = get(/databases/$(database)/documents/conexiones/$(conexionId)).data.usuarios;
      return usuarios[0] == request.auth.uid ? usuarios[1] : usuarios[0];
    }
    function tieneConexionCon(otroUid) {
      return exists(/databases/$(database)/documents/conexiones/$(idConexion(request.auth.uid, otroUid)));
    }
    // Colección heredada, sin uso en la app actual (los perfiles viven en
    // /usuarios). Se deja cerrada salvo para el propio dueño.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /usuarios/{uid} {
      // "get" y "list" se separan a propósito. Con un único `allow read`,
      // cualquiera con una cuenta podía RECORRER la colección entera y
      // descargarse la ficha de todos los usuarios — incluyendo la selfie de
      // verificación (dato biométrico) y el nombre y teléfono del contacto de
      // confianza, que es un tercero que ni siquiera usa la app.
      //
      // Leer una ficha puntual sigue permitido (hace falta para ver el perfil
      // de alguien en Descubrir o en un chat), pero recorrer la colección
      // queda solo para el panel de moderación. Como los uid son cadenas
      // aleatorias de 28 caracteres, sin poder listar no hay forma de
      // averiguarlos.
      //
      // Verificado antes de aplicar esto: el único lugar de la app que
      // recorre la colección es services/admin.js.
      allow get: if request.auth != null;
      allow list: if esAdmin();

      // Campos que decide el SERVIDOR y que el dueño no puede tocar. Sin esto,
      // `allow write` dejaba al dueño escribir cualquier campo de su propia
      // ficha — incluido `estadoVerificacion`. O sea que alguien con
      // conocimientos técnicos se ponía "aprobado" a sí mismo desde fuera de
      // la app y se saltaba la selfie por completo: la pantalla que bloquea
      // (RequireVerificacion) es del lado del cliente y no frena a quien
      // escribe directo a Firestore. Y `activarEnLugar` confía en ese mismo
      // campo para dejar activarse, así que el agujero llegaba hasta el final.
      function camposDelServidor() {
        return ['parecidoSelfie', 'verificadoEn', 'motivoRechazo', 'suspendido'];
      }
      function cambiosUsuario() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // La app sí necesita poder pedir una revisión nueva: al completar el
      // perfil y al reintentar tras un rechazo escribe `pendiente`. Ese es el
      // único valor que puede poner el cliente; "aprobado", "rechazado",
      // "falta_foto" y "error_verificacion" los escribe solo la función
      // verificarSelfie con el Admin SDK.
      function verificacionValida() {
        return !cambiosUsuario().hasAny(['estadoVerificacion']) ||
          request.resource.data.estadoVerificacion == 'pendiente';
      }
      // La fecha de nacimiento se puede escribir durante el registro, pero
      // queda congelada al terminarlo. Si no, cualquiera se cambia la edad
      // después de haber pasado el control de los 18 años.
      function fechaNacimientoValida() {
        return !cambiosUsuario().hasAny(['fechaNacimiento']) ||
          resource.data.perfilCompleto != true;
      }
      allow create: if request.auth != null && request.auth.uid == uid &&
        !request.resource.data.keys().hasAny(camposDelServidor()) &&
        !request.resource.data.keys().hasAny(['estadoVerificacion']);
      allow update: if esAdmin() || (
        request.auth != null && request.auth.uid == uid &&
        !cambiosUsuario().hasAny(camposDelServidor()) &&
        verificacionValida() &&
        fechaNacimientoValida()
      );
      // Borrar la ficha es cosa de eliminarCuenta, que usa el Admin SDK.
      allow delete: if false;

      // Datos que NADIE más debe poder leer, ni siquiera alguien que tenga tu
      // uid (y lo tiene cualquiera que se haya activado en el mismo lugar que
      // vos, porque el uid viaja dentro de cada activación):
      //   - selfieVerificacion: dato biométrico
      //   - contactoConfianza: nombre y teléfono de un tercero que ni siquiera
      //     usa la app y nunca consintió aparecer acá
      //   - correo
      // El panel de moderación necesita leer la selfie para poder aprobarla o
      // rechazarla; fuera de eso, solo el propio dueño.
      match /privado/{documento} {
        allow read, write: if request.auth != null && (request.auth.uid == uid || esAdmin());
      }
    }
    match /activaciones/{uid} {
      // Se puede leer la activación de otra persona en 3 casos: es la propia,
      // ya tienen una conexión (match) sin importar dónde esté cada quien
      // ahora (para el punto "en línea" en Mis chats), o ambos están
      // activos en el mismo lugar ahora mismo (para Descubrir).
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        tieneConexionCon(uid) ||
        (exists(/databases/$(database)/documents/activaciones/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/activaciones/$(request.auth.uid)).data.placeId == resource.data.placeId)
      );
      // El candado que faltaba. Antes esto era `allow write: if uid propio`, o
      // sea que alguien con conocimientos técnicos podía escribir su propia
      // activación con cualquier placeId y ver a toda la gente activa en ese
      // bar sin haber estado nunca ahí — justo lo contrario de lo que promete
      // la app, y de lo que le estamos explicando a Apple.
      //
      // Crear una activación queda SOLO para la Cloud Function activarEnLugar,
      // que usa el Admin SDK y no pasa por estas reglas: es la que comprueba
      // contra Google Places que el lugar esté a menos de 120 metros de las
      // coordenadas del teléfono.
      //
      // La app sí sigue actualizando su propia activación, pero únicamente los
      // campos que no dicen DÓNDE está: el latido, salir del lugar, el modo, el
      // plan, la preferencia y la pausa. placeId, lat y lng quedan intocables
      // desde el cliente.
      //
      // Se pudo cerrar recién ahora porque la versión que tienen los probadores
      // (la 21, en Play desde el 14 de agosto) ya activa a través de la
      // función. Una versión anterior a eso escribía directo y se quedaría sin
      // poder activarse en ningún lado.
      allow create: if false;
      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'actualizadaEn', 'activa', 'modo', 'plan',
          'preferenciaGenero', 'pausadoHasta', 'pausaUsada'
        ]);
      // Borrar solo lo hace eliminarCuenta, con el Admin SDK.
      allow delete: if false;
    }
    // "resource == null" cubre el caso de leer un documento que todavía no
    // existe (por ejemplo, marcarMeInteresa() revisando si la otra persona
    // ya le dio like a uno, lo normal es que ese documento no exista
    // todavía) — sin este chequeo, Firestore deniega el permiso al intentar
    // comparar campos de un resource nulo, y "Me interesa" falla siempre
    // que todavía no es mutuo (o sea, casi siempre).
    match /intereses/{interesId} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.desde == request.auth.uid || resource.data.hacia == request.auth.uid);
      // Además del dueño: esquema cerrado (antes se podía escribir cualquier
      // campo, de cualquier tamaño), cuenta no suspendida, y no se le puede
      // dar "me interesa" a alguien que te bloqueó.
      allow write: if request.auth != null &&
        request.auth.uid == request.resource.data.desde &&
        request.resource.data.keys().hasOnly(['desde', 'hacia', 'placeId', 'creadoEn']) &&
        !estaSuspendido(request.auth.uid) &&
        !meBloqueo(request.resource.data.hacia);
      allow delete: if false;
    }
    match /pases/{paseId} {
      allow read: if request.auth != null &&
        (resource == null || resource.data.desde == request.auth.uid || resource.data.hacia == request.auth.uid);
      allow write: if request.auth != null &&
        request.auth.uid == request.resource.data.desde &&
        request.resource.data.keys().hasOnly(['desde', 'hacia', 'placeId', 'creadoEn']) &&
        !estaSuspendido(request.auth.uid);
      allow delete: if false;
    }
    match /conexiones/{conexionId} {
      // "resource == null" cubre leer una conexión que todavía no existe —
      // crearConexion() en el cliente primero revisa si ya existe antes de
      // crearla, y la primera vez entre dos personas nunca existe todavía.
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.usuarios);

      // Antes alcanzaba con incluirse a uno mismo en la lista de usuarios para
      // crear una conexión con QUIEN FUERA. Con eso, cualquiera con una cuenta
      // le fabricaba un match a una persona que nunca le dio "me interesa", y
      // a partir de ahí le mandaba mensajes y notificaciones. En una app donde
      // la otra persona está a tres mesas, eso es un vector de acoso, no un
      // problema teórico.
      //
      // Ahora las reglas exigen lo mismo que ya hacía la app (ver
      // crearConexion en src/services/discover.js), así que no cambia nada
      // para el uso normal:
      //   - exactamente dos participantes, y uno sos vos
      //   - el id del documento son esos dos uid ordenados
      //   - existen los DOS documentos de interés, el tuyo y el de la otra
      //     persona, en el mismo lugar. Es lo que hace que el match sea mutuo
      //     de verdad y no una declaración del cliente.
      // El id de un interés es `{placeId}_{desde}_{hacia}` (idInteres, en
      // discover.js).
      function hayInteres(desde, hacia, placeId) {
        return exists(/databases/$(database)/documents/intereses/$(placeId + '_' + desde + '_' + hacia));
      }
      allow create: if request.auth != null &&
        request.resource.data.usuarios.size() == 2 &&
        request.auth.uid in request.resource.data.usuarios &&
        conexionId == idConexion(request.resource.data.usuarios[0], request.resource.data.usuarios[1]) &&
        hayInteres(request.resource.data.usuarios[0], request.resource.data.usuarios[1], request.resource.data.placeId) &&
        hayInteres(request.resource.data.usuarios[1], request.resource.data.usuarios[0], request.resource.data.placeId) &&
        !estaSuspendido(request.auth.uid);

      // Y un participante ya no puede reescribir el documento entero: antes
      // podía cambiar la lista de participantes y meter a un tercero en una
      // conversación ajena. Solo se tocan los campos que la app usa para el
      // chat, deshacer el match y volver a activarlo.
      function cambiosConexion() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }
      // Deshacer un match lo puede hacer cualquiera de los dos por su cuenta.
      // VOLVER A ACTIVARLO, no: si bastara con poner `deshecho: false`, quien
      // fue eliminado podría resucitar la conversación solo, que es la misma
      // puerta de acoso que cerramos al exigir interés mutuo para crearla.
      // Reactivar exige otra vez los dos "me interesa", igual que la primera
      // vez (es lo que ya hace crearConexion en el cliente).
      function reactivacionLegitima() {
        return !cambiosConexion().hasAny(['deshecho']) ||
          request.resource.data.deshecho == true ||
          (hayInteres(resource.data.usuarios[0], resource.data.usuarios[1], request.resource.data.placeId) &&
           hayInteres(resource.data.usuarios[1], resource.data.usuarios[0], request.resource.data.placeId));
      }
      allow update: if request.auth != null &&
        request.auth.uid in resource.data.usuarios &&
        cambiosConexion().hasOnly([
          'ultimoMensajeEn', 'ultimoMensajeTexto', 'ultimoMensajeAutor',
          'ultimaLectura', 'deshecho', 'deshechoEn', 'placeId', 'creadaEn'
        ]) &&
        reactivacionLegitima();
      allow delete: if false;
      match /mensajes/{mensajeId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conexiones/$(conexionId)).data.usuarios;
        // Sin estas validaciones, un mensaje podía traer los campos que
        // fuera y un texto de casi un megabyte (el tope de Firestore).
        // Consecuencias reales: cada persona que abriera el chat se lo
        // descargaba, la pantalla se trababa, la notificación push fallaba
        // (tiene un tope de 4 KB) y crecía la factura. Con un solo match
        // alcanzaba para provocarlo.
        //
        // 2000 caracteres son de sobra para un mensaje de chat: unas 400
        // palabras.
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/conexiones/$(conexionId)).data.usuarios &&
          request.resource.data.autorUid == request.auth.uid &&
          request.resource.data.keys().hasOnly(['autorUid', 'texto', 'creadoEn']) &&
          request.resource.data.texto is string &&
          request.resource.data.texto.size() > 0 &&
          request.resource.data.texto.size() <= 2000 &&
          !estaSuspendido(request.auth.uid) &&
          !meBloqueo(otroDeLaConexion(conexionId));
        allow update, delete: if false;
      }
    }
    match /reportes/{reporteId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reportadoPor;
      allow read, update: if esAdmin();
      allow delete: if false;
    }
    // Caché compartido de resultados de Google Places por zona geográfica
    // (ver buscarLugaresCercanos en services/places.js) — información
    // pública de lugares (nombre, dirección, tipo), no datos personales de
    // nadie, así que cualquier usuario logueado puede leerla y escribirla.
    // Antes esto era `allow read, write: if request.auth != null`, o sea que
    // cualquiera podía escribir lo que quisiera acá: inyectar lugares falsos
    // que después aparecen en la pantalla "¿Dónde estás?" de otras personas,
    // o guardar documentos enormes para inflar la factura. Sigue siendo
    // escribible por cualquier usuario logueado (lo necesita el caché
    // compartido), pero solo con la forma exacta que escribe la app.
    // Contador de uso por persona de la función activarEnLugar. Lo escribe y
    // lo lee solo el servidor (Admin SDK, que no pasa por estas reglas): si el
    // cliente pudiera tocarlo, borraría su propio contador y el freno no
    // serviría de nada.
    match /limites/{uid} {
      allow read, write: if false;
    }
    // Cuentas de local para el panel de dueños. El id del documento es el
    // placeId de Google, así que no pueden existir dos cuentas para el mismo
    // local: el problema de "dos personas dicen ser dueñas del mismo bar" lo
    // resuelve la base de datos sola.
    //
    // Hoy SOLO el panel de moderación crea y modifica estas cuentas, después
    // de una verificación hecha a mano. El estado y el nivel de acceso nunca
    // los puede tocar el cliente: si pudiera, un local se auto-verificaría y
    // se daría permiso para mandarle avisos a la gente que está adentro.
    //
    // Cuando exista el registro de autoservicio, acá se agrega un `create`
    // que fuerce estado 'pendiente' y nivel 'ninguno'.
    match /locales/{placeId} {
      // "resource != null" cubre el caso de consultar un local que todavía no
      // tiene cuenta: sin eso, Firestore deniega al comparar campos de un
      // documento inexistente en vez de simplemente no encontrar nada.
      allow get: if request.auth != null &&
        (esAdmin() || (resource != null && resource.data.responsableUid == request.auth.uid));
      allow list: if esAdmin();
      allow write: if esAdmin();
    }
    // Contadores anónimos por local y por hora (ver registrarEstadistica en
    // functions/index.js). No hay ningún uid acá dentro: solo cuánta gente
    // hubo, en qué local, a qué hora y en qué rango de edad.
    //
    // Los escribe únicamente el servidor con el Admin SDK, que no pasa por
    // estas reglas. El cliente no puede escribir ni leer: si pudiera escribir,
    // cualquiera podría inflar los números de un local que después se le
    // venden a su dueño como datos reales.
    match /estadisticasLugar/{bucket} {
      allow read: if esAdmin();
      allow write: if false;
    }
    // Lista de espera de la suscripción Gold: quién dijo "avísame" y con qué
    // plan se quedó mirando. No desbloquea nada ni cobra nada — es solo la
    // señal que decide si vale la pena construir el cobro.
    //
    // "get" y "list" separados, mismo criterio que /usuarios: si el dueño
    // pudiera listar, cualquiera sabría exactamente cuánta gente estaría
    // dispuesta a pagar, que es información de negocio.
    match /interesGold/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();
      // Escribir solo el propio documento, y solo con esta forma exacta: sin
      // esto se podría guardar un documento enorme para inflar la factura, o
      // un plan inventado que después ensucia el conteo.
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['creadoEn', 'plan', 'plataforma']) &&
        request.resource.data.plan in ['mensual', 'anual', 'sin_elegir'] &&
        request.resource.data.plataforma in ['android', 'ios', 'web'];
      // Borrar el propio aviso sí se permite: si alguien pidió que le avisemos
      // y cambia de opinión, tiene que poder deshacerlo.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /cachePlaces/{zonaId} {
      // Desde el 2026-08-14 el caché lo escribe y lo lee SOLO el servidor, vía
      // la Cloud Function buscarLugares (que usa el Admin SDK y no pasa por
      // estas reglas). Antes lo escribía el cliente: aunque se validaba su
      // forma, igual se podían inyectar lugares con nombres inventados que
      // después aparecían en la pantalla "¿Dónde estás?" de otras personas.
      //
      // Las versiones de la app anteriores a esta fecha intentan usarlo y
      // fallan, pero no se rompen: su código ya trataba el caché como algo
      // opcional y consulta a Google igual.
      allow read, write: if false;
    }
  }
}
